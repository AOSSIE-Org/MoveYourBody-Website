{
  "openapi": "3.0.1",
  "info": {
    "title": "MoveYourBody API",
    "version": "1.0.0",
    "description": "Machine-readable metadata for MoveYourBody, the privacy-first, open-source fitness app by AOSSIE."
  },
  "servers": [
    {
      "url": "https://move.aossie.org",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/info.json": {
      "get": {
        "summary": "Get project metadata and ecosystem information",
        "description": "Returns structured JSON with project metadata, version, features, and links.",
        "responses": {
          "200": {
            "description": "Project information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "MoveYourBody"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "description": {
            "type": "string",
            "example": "Privacy-first, open-source fitness app by AOSSIE with personalized micro-workouts and on-device AI."
          },
          "links": {
            "type": "object"
          },
          "license": {
            "type": "string",
            "example": "GPL-3.0"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Android"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
